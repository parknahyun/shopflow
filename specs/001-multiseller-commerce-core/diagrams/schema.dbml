// 스키마 ERD (DBML)
// 근거: specs/001-multiseller-commerce-core/data-model.md, ADR-0007
//
// 규칙
// - 테이블과 컬럼 이름은 코드 식별자이므로 영문 snake_case를 쓰고, 설명은 note에 한글로 적는다.
// - 금액은 원 단위 정수(bigint)다. 모든 테이블에는 created_at, updated_at이 있다(항목이 많아 표시는 일부만 한다).
// - 외래키(Ref)는 같은 컨텍스트 안에서만 건다.
//   컨텍스트 사이 참조는 식별자 값만 저장하고 외래키와 조인을 쓰지 않는다(ADR-0007).
//   그런 컬럼은 note에 "식별자 참조"와 대상을 적었다.
// - 데이터베이스가 지켜 주는 제약(유일, 음수 금지)은 index와 note로 표시한다.
// - DBML로 표현할 수 없는 부분 유일 인덱스(WHERE 조건이 붙은 것)는 note에 적고, SQL 생성 스크립트(docs/diagrams/generate-sql.ps1)의 $extra에 직접 넣는다.
// - 근거 결정: docs/adr/0009-review-decisions-payment-refund-scope.md

Project shopflow {
  database_type: 'PostgreSQL'
  Note: '샵플로우 핵심 구매·판매 흐름 스키마. 컨텍스트별 TableGroup으로 묶었다.'
}

// ───────── 상태 값 ─────────

Enum account_type {
  customer [note: '고객']
  seller [note: '판매자']
  admin [note: '운영자']
}

Enum business_type {
  sole_proprietor [note: '개인사업자']
  corporation [note: '법인사업자']
}

Enum seller_status {
  applied [note: '신청']
  approved [note: '승인']
  rejected [note: '거절 (사유 필수, 같은 정보를 고쳐 다시 신청할 수 있다)']
  suspended [note: '정지']
}

Enum product_status {
  on_sale [note: '판매 중']
  suspended [note: '판매 중지']
}

Enum order_status {
  pending_payment [note: '결제 대기']
  confirmed [note: '확정']
  cancelled [note: '취소됨']
  needs_review [note: '확인 필요']
  refunded [note: '환불됨 (확인 필요 주문의 자동 전액 환불 완료, 종료)']
}

Enum review_reason {
  late_deposit [note: '기한 후 입금']
  paid_after_reservation_expiry [note: '재고 확보 만료 뒤 결제 성공']
  amount_mismatch [note: '금액 불일치']
}

Enum cancel_actor {
  customer [note: '고객']
  seller [note: '판매자']
  system [note: '시스템']
}

Enum sub_order_status {
  before_shipping [note: '발송 전']
  shipping [note: '배송 중']
  delivered [note: '배송 완료']
  purchase_confirmed [note: '구매 확정']
  cancelled [note: '취소']
}

Enum reservation_status {
  held [note: '유지']
  confirmed [note: '확정']
  released [note: '반환']
}

Enum payment_method {
  immediate [note: '즉시 결제']
  deposit_wait [note: '입금 대기(가상계좌)']
}

Enum payment_status {
  ready [note: '준비']
  approval_wait [note: '승인 대기']
  deposit_wait [note: '입금 대기']
  succeeded [note: '성공']
  failed [note: '실패']
  expired [note: '만료 (만료 뒤 성공으로 가는 경우를 빼면 종료)']
}

Enum transaction_type {
  approval [note: '승인']
  refund [note: '환불']
}

Enum refund_reason {
  customer_cancel [note: '고객 취소']
  seller_cancel [note: '판매자 취소']
  review_refund [note: '확인 필요 환불']
  pending_cancel [note: '결제 대기 취소']
}

Enum refund_status {
  requested [note: '요청']
  checking [note: '확인 중']
  completed [note: '완료']
  failed [note: '실패']
}

Enum idempotency_status {
  processing [note: '처리 중']
  completed [note: '완료']
  failed [note: '실패']
}

// ───────── 계정 컨텍스트 ─────────

Table account {
  id bigint [pk, increment]
  public_id varchar(36) [not null, unique, note: '화면과 외부에 노출하는 식별자']
  type account_type [not null]
  email varchar(255) [not null]
  password_hash varchar(255) [not null, note: '솔트가 적용된 해시만 저장']
  status varchar(20) [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (type, email) [unique, name: 'uq_account_type_email']
  }
  Note: '고객, 판매자, 운영자 계정. 계정 유형별로 이메일이 유일하다.'
}

Table seller_profile {
  id bigint [pk, increment]
  account_id bigint [not null, unique]
  business_type business_type [not null]
  business_name varchar(100) [not null, note: '상호명']
  business_registration_no varchar(20) [not null, unique, note: '사업자등록번호, 유일']
  representative_name varchar(50) [not null, note: '대표자명 (대표자 주민등록번호는 저장하지 않는다)']
  phone varchar(30) [not null]
  business_address varchar(255) [not null]
  mail_order_report_no varchar(50) [not null, note: '통신판매업 신고번호']
  corporate_name varchar(100) [note: '법인사업자만. 개인사업자는 null']
  corporate_registration_no varchar(20) [note: '법인사업자만. 개인사업자는 null']
  status seller_status [not null]
  reject_reason varchar(500) [note: '거절 사유. status가 rejected일 때 필수(검사 제약)']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  checks {
    `(business_type = 'corporation' AND corporate_name IS NOT NULL AND corporate_registration_no IS NOT NULL) OR (business_type = 'sole_proprietor' AND corporate_name IS NULL AND corporate_registration_no IS NULL)` [name: 'ck_seller_corporate_fields']
    `status <> 'rejected' OR reject_reason IS NOT NULL` [name: 'ck_seller_reject_reason']
  }
  Note: '판매자 정보. 법인사업자는 corporate_name과 corporate_registration_no가 필수, 개인사업자는 비어 있어야 한다(검사 제약). 거절된 판매자는 같은 행을 고쳐 신청 상태로 되돌린다(재신청).'
}

Table seller_document {
  id bigint [pk, increment]
  seller_profile_id bigint [not null]
  document_type varchar(30) [not null, note: '사업자등록증 사본 등']
  file_path varchar(500) [not null, note: '서버가 정한 이름으로 비공개 위치에 저장']
  submitted_at timestamptz [not null]

  Note: '입점 서류. 판매자 본인과 운영자만 조회할 수 있다. 신청·거절 상태에서 다시 올릴 수 있다.'
}

Ref: seller_profile.account_id > account.id
Ref: seller_document.seller_profile_id > seller_profile.id

// ───────── 상품 컨텍스트 ─────────

Table product {
  id bigint [pk, increment]
  public_id varchar(36) [not null, unique]
  seller_id bigint [not null, note: '식별자 참조: 계정 컨텍스트의 seller_profile.id (외래키 아님)']
  name varchar(200) [not null]
  description text
  status product_status [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    seller_id
    (status, name)
  }
  Note: '판매자가 등록한 상품. 하나 이상의 판매 단위를 가진다.'
}

Table product_photo {
  id bigint [pk, increment]
  product_id bigint [not null]
  file_path varchar(500) [not null]
  sort_order int [not null]
}

Table product_variant {
  id bigint [pk, increment]
  product_id bigint [not null]
  option_values jsonb [not null, note: '옵션 조합. 예: {"색상":"빨강","사이즈":"M"}. 옵션이 없으면 빈 객체']
  price bigint [not null, note: '원 단위. 0보다 커야 한다(검사 제약). 재고 수량은 stock이 소유한다']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (product_id, option_values) [unique, name: 'uq_variant_product_options']
  }
  checks {
    `price > 0` [name: 'ck_variant_price_positive']
  }
  Note: '판매 단위(옵션 조합). 고객이 실제로 고르고 사는 단위.'
}

Ref: product_photo.product_id > product.id
Ref: product_variant.product_id > product.id

// ───────── 재고 컨텍스트 ─────────

Table stock {
  id bigint [pk, increment]
  variant_id bigint [not null, unique, note: '식별자 참조: 상품 컨텍스트의 product_variant.id (외래키 아님)']
  total_qty bigint [not null, note: '총 보유 수량. 판매자가 입력할 때만 바뀐다. 총 보유 수량 = 가용 + 유지 + 판매된 수량']
  available_qty bigint [not null, note: '가용 수량. 0 이상이며 검사 제약으로 음수를 막는다. 조건부 갱신으로만 바꾼다. 판매자 수정 시 새 가용 = 현재 가용 + (입력 총량 - 기존 총량)']
  version bigint [not null, note: '버전. 판매자 수정은 WHERE version = 읽은 버전 조건부 갱신으로 동시 수정을 거절']
  updated_at timestamptz [not null]

  checks {
    `available_qty >= 0` [name: 'ck_stock_non_negative']
  }
  Note: '판매 단위별 재고. 판매 단위마다 한 행이다. 판매자는 총 보유 수량을 입력하고 서버가 가용 수량을 계산한다.'
}

Table stock_reservation {
  id bigint [pk, increment]
  stock_id bigint [not null]
  order_id bigint [not null, note: '식별자 참조: 주문 컨텍스트의 customer_order.id (외래키 아님)']
  variant_id bigint [not null, note: '식별자 참조: 상품 컨텍스트의 product_variant.id (외래키 아님)']
  quantity int [not null]
  expires_at timestamptz [not null, note: '결제 방식별 설정값(즉시 결제 15분, 입금 대기 24시간)']
  status reservation_status [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (status, expires_at) [name: 'ix_reservation_expiry', note: '만료 처리 스케줄러가 사용']
    order_id
  }
  checks {
    `quantity > 0` [name: 'ck_reservation_quantity_positive']
  }
  Note: '재고 확보(선점). held 상태의 수량은 이미 stock에서 차감되어 있다. 반환은 status가 held일 때만 한 번 일어난다. 발송 전 취소로 재고를 더해도 status는 confirmed 그대로다.'
}

Ref: stock_reservation.stock_id > stock.id

// ───────── 주문 컨텍스트 ─────────

Table cart_item {
  id bigint [pk, increment]
  customer_id bigint [not null, note: '식별자 참조: 계정 컨텍스트의 account.id (외래키 아님)']
  variant_id bigint [not null, note: '식별자 참조: 상품 컨텍스트의 product_variant.id (외래키 아님)']
  quantity int [not null, note: '1 이상']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (customer_id, variant_id) [unique, name: 'uq_cart_customer_variant']
  }
  checks {
    `quantity >= 1` [name: 'ck_cart_quantity_positive']
  }
}

Table customer_order {
  id bigint [pk, increment]
  public_id varchar(36) [not null, unique]
  customer_id bigint [not null, note: '식별자 참조: 계정 컨텍스트의 account.id (외래키 아님)']
  total_amount bigint [not null, note: '주문 생성 시점의 하위 주문 금액 합계. 이후 일부 취소로 바뀌지 않는다']
  status order_status [not null]
  review_reason review_reason [note: '확인 필요 사유. status가 needs_review일 때 필수(검사 제약)']
  shipping_recipient varchar(50) [not null]
  shipping_phone varchar(30) [not null]
  shipping_address varchar(255) [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (customer_id, created_at)
    (customer_id, status) [note: '고객당 동시 결제 대기 주문 수 상한(기본 3건) 검사']
  }
  checks {
    `status <> 'needs_review' OR review_reason IS NOT NULL` [name: 'ck_order_review_reason']
  }
  Note: '고객이 한 번에 결제한 전체 구매. 결제 대기 주문은 고객이 주문 단위로 취소할 수 있다.'
}

Table sub_order {
  id bigint [pk, increment]
  public_id varchar(36) [not null, unique]
  order_id bigint [not null]
  seller_id bigint [not null, note: '식별자 참조: 계정 컨텍스트의 seller_profile.id (외래키 아님)']
  amount bigint [not null]
  status sub_order_status [not null, note: '상태 변경은 WHERE status = 현재 상태 조건부 갱신으로만 한다. 취소와 발송이 동시에 오면 먼저 처리된 요청만 반영']
  purchase_confirmed_at timestamptz
  cancelled_at timestamptz
  cancelled_by cancel_actor [note: '취소 주체. 취소 상태일 때 필수']
  cancel_reason varchar(500) [note: '취소 사유. 판매자 취소는 필수(검사 제약)']
  delivered_at timestamptz [note: '배송 완료 시각(delivery.delivered_at의 복사값). 자동 구매 확정 기준']
  problem_reported_at timestamptz [note: '문제 신고 시각. 신고된 하위 주문은 자동 구매 확정에서 빠진다']
  problem_reason varchar(500) [note: '문제 신고 사유. 신고 시 필수']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (seller_id, status)
    (status, delivered_at) [note: '배송 완료 후 7일 지난 건의 자동 구매 확정 조회(문제 신고 건 제외)']
  }
  checks {
    `cancelled_by IS NULL OR cancelled_by <> 'seller' OR cancel_reason IS NOT NULL` [name: 'ck_sub_order_seller_cancel_reason']
  }
  Note: '판매자별 하위 주문. 배송, 취소, 구매 확정, 이후 정산과 환불의 단위. 취소는 속한 주문이 확정된 뒤에만 한다.'
}

Table sub_order_item {
  id bigint [pk, increment]
  sub_order_id bigint [not null]
  variant_id bigint [not null, note: '식별자 참조: 상품 컨텍스트의 product_variant.id (외래키 아님)']
  quantity int [not null]
  unit_price bigint [not null, note: '주문 당시 단가. 이후 가격이 바뀌어도 달라지지 않는다']

  checks {
    `quantity >= 1` [name: 'ck_sub_order_item_quantity_positive']
  }
}

Ref: sub_order.order_id > customer_order.id
Ref: sub_order_item.sub_order_id > sub_order.id

// ───────── 배송 컨텍스트 ─────────

Table delivery {
  id bigint [pk, increment]
  sub_order_id bigint [not null, unique, note: '식별자 참조: 주문 컨텍스트의 sub_order.id (외래키 아님). 하위 주문마다 최대 하나']
  carrier varchar(50) [not null, note: '택배사']
  tracking_no varchar(50) [not null, note: '송장 번호']
  delivered_at timestamptz [note: '판매자가 배송 완료 처리를 할 때 기록']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: '배송 정보. 송장 입력과 하위 주문의 상태 변경(발송 전에서 배송 중)은 같은 트랜잭션에서 처리하고, 이미 취소된 하위 주문이면 저장하지 않는다.'
}

// ───────── 결제 컨텍스트 ─────────

Table payment {
  id bigint [pk, increment]
  public_id varchar(36) [not null, unique]
  order_id bigint [not null, note: '식별자 참조: 주문 컨텍스트의 customer_order.id (외래키 아님)']
  method payment_method [not null]
  amount bigint [not null, note: '주문 총액과 같아야 한다']
  status payment_status [not null]
  gateway_payment_key varchar(100) [note: '대행사 결제 키']
  deposit_deadline timestamptz [note: '입금 대기 방식일 때만']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    order_id
    gateway_payment_key [unique]
    (status, deposit_deadline) [note: '입금 기한 만료 자동 취소 조회']
  }
  Note: '결제. 한 주문에 성공(succeeded) 결제는 하나만 있어야 하고(order_id 부분 유일 인덱스: WHERE status = succeeded), 비종료 결제(ready, approval_wait, deposit_wait)도 하나만 있어야 한다(order_id 부분 유일 인덱스: WHERE status IN (ready, approval_wait, deposit_wait)). 만료(expired)는 만료 뒤 성공 전이가 있어 종료 상태가 아닐 수 있다.'
}

Table payment_transaction {
  id bigint [pk, increment]
  payment_id bigint [not null]
  type transaction_type [not null]
  sub_order_id bigint [note: '식별자 참조: 주문 컨텍스트의 sub_order.id (외래키 아님). 환불일 때 대상']
  refund_id bigint [note: '환불 완료로 추가된 행이면 해당 refund.id']
  amount bigint [not null]
  gateway_transaction_key varchar(100)
  occurred_at timestamptz [not null]

  indexes {
    (sub_order_id, type)
  }
  Note: '추가 전용. 수정과 삭제를 하지 않고 환불은 새 행을 추가한다. 하위 주문별 환불 합계는 그 하위 주문 금액을 넘을 수 없다.'
}

Table refund {
  id bigint [pk, increment]
  payment_id bigint [not null]
  sub_order_id bigint [note: '식별자 참조: 주문 컨텍스트의 sub_order.id (외래키 아님). 비어 있으면 주문 전체 환불']
  amount bigint [not null, note: '원 단위. 환불 합계(진행 중과 완료)는 하위 주문 금액과 결제 금액을 넘을 수 없다']
  reason refund_reason [not null]
  status refund_status [not null, note: '요청 -> 완료/실패/확인 중, 확인 중 -> 완료/실패. 실패는 새 행(새 멱등키)으로 재시도']
  idem_key varchar(100) [not null, note: '시도마다 새로 만드는 멱등키']
  attempt_no int [not null, note: '시도 번호. 1부터, 재시도마다 1 증가']
  gateway_refund_key varchar(100) [note: '대행사 환불 키']
  failure_reason varchar(500) [note: '실패 사유. 운영자가 조회']
  requested_at timestamptz [not null]
  completed_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    idem_key [unique, name: 'uq_refund_idem_key']
    (status, requested_at) [note: '환불 재시도 작업이 요청·확인 중·실패 행을 찾는다']
    (sub_order_id, status)
  }
  checks {
    `amount > 0` [name: 'ck_refund_amount_positive']
  }
  Note: '환불. 취소와 같은 트랜잭션에서 요청 상태로 먼저 기록한 뒤 대행사를 호출한다. 하위 주문 하나에 진행 중(요청, 확인 중)이거나 완료된 환불은 하나만(sub_order_id 부분 유일 인덱스: WHERE sub_order_id IS NOT NULL AND status IN (requested, checking, completed)). 주문 전체 환불은 결제당 하나(payment_id 부분 유일 인덱스: WHERE sub_order_id IS NULL AND status IN (requested, checking, completed)).'
}

Table refund_account {
  id bigint [pk, increment]
  payment_id bigint [not null, unique, note: '입금 대기(가상계좌) 방식 결제에만 있다. 결제당 하나']
  bank varchar(30) [not null]
  account_no_encrypted bytea [note: '계좌번호 암호문. 로그에 남기지 않는다. 환불이 완료되면 지운다']
  account_no_masked varchar(30) [not null, note: '화면에 보이는 마스킹 값']
  holder_name varchar(50) [not null, note: '예금주']
  masked_at timestamptz [note: '환불 완료 뒤 원문을 지우고 마스킹한 시각']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: '가상계좌 환불 계좌. 고객이 입금 대기 방식으로 결제를 시작할 때 입력한다. 대행사별 요구 사양은 구현 전에 확인한다.'
}

Ref: payment_transaction.payment_id > payment.id
Ref: refund.payment_id > payment.id
Ref: refund_account.payment_id > payment.id

// ───────── 공통 컨텍스트 ─────────

Table idempotency_key {
  id bigint [pk, increment]
  scope varchar(30) [not null, note: '결제 시작, 결제 승인, 취소, 환불, 웹훅']
  idem_key varchar(100) [not null, note: '웹훅은 대행사 이벤트 식별자를 쓴다']
  request_hash varchar(64) [not null, note: '요청 내용 해시. 같은 키에 다른 내용이면 거절']
  status idempotency_status [not null]
  result jsonb [note: '저장된 처리 결과. 실패한 결과도 저장한다']
  claim_expires_at timestamptz [note: '처리 중 점유 만료 시각. 지나면 다른 요청이 대행사 조회로 이어받거나 실패로 바꾼다']
  expires_at timestamptz [not null, note: '완료·실패 키를 정리하는 시각']
  created_at timestamptz [not null]

  indexes {
    (scope, idem_key) [unique, name: 'uq_idempotency_scope_key']
    expires_at
    (status, claim_expires_at) [note: '점유 만료된 처리 중 키 회수']
  }
  Note: '중복 방지. (범위, 키)가 유일하다. 키는 시도마다 새로 만든다. 오래된 키는 정리 작업이 지운다.'
}

Table audit_log {
  id bigint [pk, increment]
  target_type varchar(30) [not null, note: '결제, 주문, 하위 주문, 재고 확보, 환불']
  target_id bigint [not null, note: '식별자 참조(대상 종류에 따라 다름, 외래키 아님)']
  from_status varchar(30)
  to_status varchar(30) [not null]
  actor varchar(100) [not null, note: '행위자(계정 식별자 또는 시스템)']
  occurred_at timestamptz [not null]

  indexes {
    (target_type, target_id)
  }
  Note: '변경 이력. 추가만 하고 수정과 삭제를 하지 않는다. 개인정보, 카드 정보, 환불 계좌번호는 담지 않는다.'
}

// ───────── 컨텍스트 묶음 ─────────

TableGroup account_context [note: '계정 컨텍스트'] {
  account
  seller_profile
  seller_document
}

TableGroup product_context [note: '상품 컨텍스트'] {
  product
  product_photo
  product_variant
}

TableGroup inventory_context [note: '재고 컨텍스트'] {
  stock
  stock_reservation
}

TableGroup order_context [note: '주문 컨텍스트'] {
  cart_item
  customer_order
  sub_order
  sub_order_item
}

TableGroup delivery_context [note: '배송 컨텍스트'] {
  delivery
}

TableGroup payment_context [note: '결제 컨텍스트'] {
  payment
  payment_transaction
  refund
  refund_account
}

TableGroup common_context [note: '공통(횡단) 컨텍스트'] {
  idempotency_key
  audit_log
}
