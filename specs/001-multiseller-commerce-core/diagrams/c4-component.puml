@startuml
' C4 모델 3단계: 컴포넌트 (샵플로우 애플리케이션 내부)
' 근거: plan.md 프로젝트 구조, data-model.md 바운디드 컨텍스트, ADR-0001~0007, 시퀀스 다이어그램
!include <C4/C4_Component>
HIDE_STEREOTYPE()

title 컴포넌트 다이어그램: 샵플로우 애플리케이션

Container(browser, "웹 브라우저", "HTML", "고객, 판매자, 운영자 화면")
ContainerDb(db, "데이터베이스", "포스트그레스큐엘", "컨텍스트마다 자기 테이블만 쓴다")
ContainerDb(files, "파일 저장소", "서버 디스크", "상품 사진, 입점 서류")
System_Ext(pg, "결제 대행사", "결제, 조회, 환불, 웹훅")

Boundary(app, "샵플로우 애플리케이션 (모듈형 모놀리스)", "컨테이너") {

  Component(web, "화면 계층", "스프링 MVC, 타임리프", "경로별 컨트롤러와 화면. 서비스 인터페이스만 호출하고 도메인 객체를 직접 다루지 않는다.")
  Component(security, "보안", "스프링 시큐리티", "로그인, 계정 유형별 권한, 사이트 간 요청 위조 방어, 비밀번호 해시")
  Component(scheduler, "예약 작업", "스프링 스케줄러", "1분마다 만료된 재고 선점 반환, 입금 기한 만료 취소, 7일 지난 배송 완료 건 자동 구매 확정. 건너뜀 잠금으로 중복 실행을 막는다.")

  Boundary(b_account, "계정 컨텍스트") {
    Component(account_svc, "계정 서비스", "자바", "가입, 입점 신청, 운영자 승인과 거절, 입점 서류 보관, 사업자등록번호 유일성")
  }
  Boundary(b_product, "상품 컨텍스트") {
    Component(product_svc, "상품 서비스", "자바", "상품과 옵션 조합 등록, 판매 중지, 검색. 재고 등록은 재고 서비스에 맡긴다.")
  }
  Boundary(b_order, "주문 컨텍스트") {
    Component(cart_svc, "장바구니 서비스", "자바", "담기, 수량 변경, 빼기")
    Component(order_svc, "주문 서비스", "자바", "주문과 하위 주문 생성, 상태 전이(조건부 갱신), 취소, 구매 확정, 판매자별 조회 제한")
    Component(checkout, "결제 시작 조정", "자바", "재고 선점, 주문 생성, 결제 준비를 순서대로 부르고, 결제 결과에 따라 확정 또는 취소를 지시한다. 단계마다 멱등하다.")
  }
  Boundary(b_inventory, "재고 컨텍스트") {
    Component(stock_svc, "재고 서비스", "자바", "재고(가용 수량)와 재고 확보. 조건부 갱신으로만 차감과 가산을 하고, 확보의 상태 변경은 한 번만 일어난다.")
  }
  Boundary(b_payment, "결제 컨텍스트") {
    Component(pay_svc, "결제 서비스", "자바", "결제 준비, 승인 확인(서버 직접 조회, 금액 대조), 환불, 결제 거래 내역")
    Component(pay_port, "결제 포트", "자바 인터페이스", "준비, 승인, 조회, 환불. 테스트에서는 가짜 구현으로 바꾼다.")
    Component(pay_adapter, "대행사 어댑터", "자바, HTTP 클라이언트", "결제 대행사 호출 구현. 멱등키 헤더를 붙인다.")
    Component(webhook, "웹훅 수신", "스프링 MVC", "서명 검증, 이벤트 식별자로 중복 제거, 조회로 다시 확인한 뒤 반영")
  }
  Boundary(b_delivery, "배송 컨텍스트") {
    Component(delivery_svc, "배송 서비스", "자바", "송장과 배송 완료 시각 기록")
  }
  Boundary(b_common, "공통 컨텍스트") {
    Component(idem, "멱등키 서비스", "자바", "(범위, 키) 유일 제약으로 중복 요청을 막고 결과를 저장")
    Component(audit, "변경 이력", "자바", "결제, 주문, 하위 주문, 재고 확보의 상태 변경을 추가만 한다")
    Component(storage_port, "파일 저장 포트", "자바 인터페이스", "형식과 크기 검사, 서버가 정한 이름으로 비공개 저장")
  }
}

Rel(browser, security, "요청", "HTTPS")
Rel(security, web, "인증된 요청 전달")
Rel(web, account_svc, "가입, 입점, 승인")
Rel(web, product_svc, "상품 등록과 조회")
Rel(web, cart_svc, "장바구니")
Rel(web, checkout, "주문하기, 결제 승인 요청")
Rel(web, order_svc, "주문 조회, 취소, 구매 확정, 발송 처리")
Rel(web, webhook, "웹훅 요청", "인증 없이 서명으로 검증")

Rel(checkout, idem, "중복 요청 확인")
Rel(checkout, stock_svc, "재고 선점, 확정, 반환")
Rel(checkout, order_svc, "주문과 하위 주문 생성, 확정, 취소")
Rel(checkout, pay_svc, "결제 준비, 승인 확인")
Rel(order_svc, delivery_svc, "송장 저장, 배송 완료 시각 기록")
Rel(order_svc, pay_svc, "발송 전 취소 환불 요청")
Rel(order_svc, stock_svc, "취소 시 재고 가산")
Rel(product_svc, stock_svc, "재고 등록과 수정")
Rel(product_svc, storage_port, "사진 저장")
Rel(account_svc, storage_port, "입점 서류 저장")
Rel(webhook, pay_svc, "입금 완료 반영")
Rel(pay_svc, pay_port, "사용")
Rel(pay_adapter, pay_port, "구현", "구현 관계")
Rel(pay_adapter, pg, "결제, 조회, 환불", "HTTPS")
Rel(pg, webhook, "입금 완료 알림", "HTTPS")
Rel(scheduler, stock_svc, "만료된 재고 확보 반환")
Rel(scheduler, checkout, "입금 기한 만료 취소 지시")
Rel(scheduler, order_svc, "자동 구매 확정")

Rel(order_svc, audit, "상태 변경 기록")
Rel(stock_svc, audit, "상태 변경 기록")
Rel(pay_svc, audit, "상태 변경 기록")
Rel(pay_svc, idem, "환불과 웹훅 중복 방지")

Rel(account_svc, db, "계정 테이블", "JDBC")
Rel(product_svc, db, "상품 테이블", "JDBC")
Rel(order_svc, db, "주문 테이블", "JDBC")
Rel(stock_svc, db, "재고 테이블", "JDBC")
Rel(pay_svc, db, "결제 테이블", "JDBC")
Rel(delivery_svc, db, "배송 테이블", "JDBC")
Rel(idem, db, "공통 테이블", "JDBC")
Rel(storage_port, files, "파일 입출력")

note bottom of checkout
  컨텍스트를 가로지르는 흐름(결제 시작, 결제 성공, 발송 전 취소)은
  첫 구현에서 서비스 인터페이스를 거쳐 한 트랜잭션으로 묶는다.
  분리할 때는 이 조정이 보상 처리로 바뀐다. (ADR-0007)
end note
note as N_Legend
  파란색 진한 사각형: 사람(고객, 판매자, 운영자)
  파란색 사각형: 우리 시스템, 컨테이너, 컴포넌트
  회색 사각형: 외부 시스템
  점선 상자: 경계(시스템, 컨테이너, 컨텍스트)
end note
@enduml