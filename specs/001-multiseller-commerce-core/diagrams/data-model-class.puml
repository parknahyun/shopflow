@startuml
' 데이터 모델 클래스 다이어그램
' 근거: specs/001-multiseller-commerce-core/data-model.md
' 모든 금액은 원 단위 정수(Long)이고, 모든 개체는 생성 시각과 수정 시각을 가진다(그림에서는 생략).
title 데이터 모델 (클래스 다이어그램)

skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty methods

' 바운디드 컨텍스트
rectangle "계정 컨텍스트" {
  class 계정 {
    공개식별자
    유형 : 계정유형
    이메일
    비밀번호해시
    상태
  }
  class 판매자정보 {
    사업자유형 : 사업자유형
    상호명
    사업자등록번호
    대표자명
    연락처
    사업장주소
    통신판매업신고번호
    법인명 [0..1]
    법인등록번호 [0..1]
    입점상태 : 입점상태
    거절사유 [0..1]
  }
  class 입점서류 {
    서류종류
    파일저장위치
    제출시각
  }
  enum 계정유형 {
    고객
    판매자
    운영자
  }
  enum 사업자유형 {
    개인사업자
    법인사업자
  }
  enum 입점상태 {
    신청
    승인
    거절
    정지
  }
}

rectangle "상품 컨텍스트" {
  class 상품 {
    공개식별자
    이름
    설명 [0..1]
    사진목록
    판매상태 : 상품판매상태
  }
  class 판매단위 {
    옵션값목록
    가격 : Long
  }
  enum 상품판매상태 {
    판매중
    판매중지
  }
}

rectangle "재고 컨텍스트" {
  class 재고 {
    총보유수량 : Long
    가용수량 : Long
    버전
  }
  class 재고확보 {
    수량
    만료시각
    상태 : 재고확보상태
  }
  enum 재고확보상태 {
    유지
    확정
    반환
  }
}

rectangle "주문 컨텍스트" {
  class 장바구니항목 {
    수량
  }
  class 주문 {
    공개식별자
    총금액 : Long
    상태 : 주문상태
    확인필요사유 : 확인필요사유 [0..1]
    배송지정보
  }
  class 하위주문 {
    공개식별자
    금액 : Long
    배송상태 : 배송상태
    구매확정시각 [0..1]
    취소시각 [0..1]
    취소주체 : 취소주체 [0..1]
    취소사유 [0..1]
    배송완료시각 [0..1]
    문제신고시각 [0..1]
    문제신고사유 [0..1]
  }
  class 하위주문항목 {
    수량
    주문당시단가 : Long
  }
  enum 주문상태 {
    결제대기
    확정
    취소됨
    확인필요
    환불됨
  }
  enum 확인필요사유 {
    기한후입금
    확보만료뒤결제성공
    금액불일치
  }
  enum 취소주체 {
    고객
    판매자
    시스템
  }
  enum 배송상태 {
    발송전
    배송중
    배송완료
    구매확정
    취소
  }
}

rectangle "배송 컨텍스트" {
  class 배송정보 {
    택배사
    송장번호
    배송완료시각 [0..1]
  }
}

rectangle "결제 컨텍스트" {
  class 결제 {
    결제방식 : 결제방식
    금액 : Long
    상태 : 결제상태
    대행사결제키 [0..1]
    입금기한 [0..1]
  }
  class 결제거래내역 {
    유형 : 거래유형
    금액 : Long
    대행사거래키 [0..1]
    발생시각
  }
  class 환불 {
    금액 : Long
    사유 : 환불사유
    상태 : 환불상태
    멱등키
    시도번호
    대행사환불키 [0..1]
    실패사유 [0..1]
    요청시각
    완료시각 [0..1]
  }
  class 환불계좌 {
    은행
    계좌번호(암호화)
    마스킹계좌번호
    예금주
    마스킹시각 [0..1]
  }
  enum 결제방식 {
    즉시결제
    입금대기
  }
  enum 결제상태 {
    준비
    승인대기
    입금대기
    성공
    실패
    만료
  }
  enum 거래유형 {
    승인
    환불
  }
  enum 환불사유 {
    고객취소
    판매자취소
    확인필요환불
    결제대기취소
  }
  enum 환불상태 {
    요청
    확인중
    완료
    실패
  }
}

rectangle "공통(횡단) 컨텍스트" {
  class 멱등키 {
    범위
    키
    요청내용해시
    처리상태 : 처리 중, 완료, 실패
    저장된결과 [0..1]
    점유만료시각 [0..1]
    만료시각
  }
  class 감사이력 {
    대상종류
    대상식별자
    이전상태 [0..1]
    이후상태
    행위자
    발생시각
  }
}

' 상태 값 연결 (회색 점선)
계정 ..> 계정유형
판매자정보 ..> 사업자유형
판매자정보 ..> 입점상태
상품 ..> 상품판매상태
주문 ..> 주문상태
하위주문 ..> 배송상태
재고확보 ..> 재고확보상태
결제 ..> 결제방식
결제 ..> 결제상태
환불 ..> 환불사유
환불 ..> 환불상태
주문 ..> 확인필요사유
하위주문 ..> 취소주체
결제거래내역 ..> 거래유형

' 같은 컨텍스트 안의 관계 (실선)
계정 "1" -- "0..1" 판매자정보 : 판매자 계정만
판매자정보 "1" *-- "1..*" 입점서류 : 제출
상품 "1" *-- "1..*" 판매단위 : 구성
주문 "1" *-- "1..*" 하위주문
하위주문 "1" *-- "1..*" 하위주문항목
재고 "1" -- "0..*" 재고확보 : 판매 단위 기준
결제 "1" *-- "1..*" 결제거래내역
결제 "1" *-- "0..*" 환불
결제 "1" *-- "0..1" 환불계좌 : 입금 대기 결제만
환불 "1" -- "0..*" 결제거래내역 : 완료 시 행 추가

' 컨텍스트 사이 관계: 식별자 값으로만 참조한다 (파란 점선)
상품 "0..*" -[#1f6feb,dashed]-> "1" 판매자정보 : 판매자 식별자
장바구니항목 "0..*" -[#1f6feb,dashed]-> "1" 계정 : 고객 식별자
장바구니항목 "0..*" -[#1f6feb,dashed]-> "1" 판매단위 : 판매 단위 식별자
주문 "0..*" -[#1f6feb,dashed]-> "1" 계정 : 고객 식별자
하위주문 "0..*" -[#1f6feb,dashed]-> "1" 판매자정보 : 판매자 식별자
하위주문항목 "0..*" -[#1f6feb,dashed]-> "1" 판매단위 : 판매 단위 식별자
재고 "1" -[#1f6feb,dashed]-> "1" 판매단위 : 판매 단위 식별자
재고확보 "0..*" -[#1f6feb,dashed]-> "1" 주문 : 주문 식별자
배송정보 "0..1" -[#1f6feb,dashed]-> "1" 하위주문 : 하위 주문 식별자
결제 "0..*" -[#1f6feb,dashed]-> "1" 주문 : 주문 식별자
결제거래내역 "0..*" -[#1f6feb,dashed]-> "0..1" 하위주문 : 환불 대상 식별자
환불 "0..*" -[#1f6feb,dashed]-> "0..1" 하위주문 : 환불 대상 식별자\n(없으면 주문 전체)

note bottom of 입점서류
  판매자 본인과 운영자만 볼 수 있다.
  대표자 주민등록번호는 저장하지 않는다.
  사업자등록번호는 유일하다.
end note

note bottom of 멱등키
  결제 시작, 결제 승인, 취소·환불,
  웹훅 요청의 중복을 막는다.
  (범위, 키)가 유일하다.
end note

note bottom of 감사이력
  결제, 주문, 하위 주문, 재고 확보, 환불의
  상태가 바뀔 때마다 한 행을 추가한다.
  수정과 삭제는 하지 않는다.
end note

note right of 결제거래내역
  추가 전용이다. 환불은 새 행을 추가한다.
  하위 주문별 환불 합계는
  그 하위 주문 금액을 넘을 수 없다.
end note

note bottom of 환불
  취소와 같은 트랜잭션에서 요청으로 먼저 기록한다.
  하위 주문(또는 주문 전체)당 진행 중·완료 환불은 하나.
  실패는 새 환불 행(새 멱등키)으로 재시도한다.
end note

note bottom of 환불계좌
  가상계좌 결제의 환불에 쓴다. 암호화해서 저장하고
  로그에 남기지 않으며 환불 완료 뒤 마스킹한다.
end note

note as N_Context
  바운디드 컨텍스트는 계획서의 기능 단위 패키지와 같고,
  목표는 컨텍스트별 별도 인스턴스다. (ADR-0007)
  첫 구현은 분리 가능한 모듈형 모놀리스로 시작한다.
  컨텍스트 사이에는 외래키와 조인을 쓰지 않고
  식별자 값으로만 참조한다 (파란 점선).
  재고 수량은 재고 컨텍스트가 소유하고 조건부 갱신으로만 바꾼다.
  판매자는 총 보유 수량을 입력하고 서버가 가용 수량을 계산한다(버전 검사).
  배송 상태 전이(취소와 발송의 경쟁 포함)는
  하위 주문의 상태 한 곳에서 조건부로 처리한다.
end note

legend right
  실선: 같은 컨텍스트 안의 관계
  파란 점선: 컨텍스트 사이의 식별자 참조
  회색 점선: 상태 값(열거형)
  [0..1]: 값이 없을 수 있는 선택 속성 (표시 없음: 필수)
  다중도: 1 정확히 하나, 0..1 없거나 하나,
          0..* 0개 이상, 1..* 1개 이상
endlegend
@enduml
